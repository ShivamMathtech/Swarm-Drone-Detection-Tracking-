MODEL_PATH=weights/drone_detector.pt
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.50
IMAGE_SIZE=1280
DEVICE=cpu
TRACKER=bytetrack
TRACK_BUFFER=30
MATCH_THRESHOLD=0.8
TARGET_FPS=30
FRAME_SKIP=0
MAX_FRAME_WIDTH=1280
# Settings saved by the UI override these defaults. Delete runtime/research.sqlite3
# only if you want to reset configuration AND delete all session history.
# Keep credentials in this local file; frontend sends only the alias below.
CAM_RTSP_URL=rtsp://username:password@camera-ip:554/stream
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
